# Clave publicable de Clerk (autenticación)
VITE_CLERK_PUBLISHABLE_KEY=

# URL base de la API del backend (ej. http://localhost:4000/api)
VITE_API_URL=

# Clave pública VAPID para notificaciones Web Push (UX-68). Debe coincidir con
# VAPID_PUBLIC_KEY de apps/server/.env. Generar el par una vez con:
# npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
