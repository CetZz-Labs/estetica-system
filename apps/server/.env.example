# Puerto en el que escucha el servidor Express (opcional, default interno según index.ts)
PORT=

# Cadena de conexión a MongoDB Atlas (o instancia local)
DATABASE_URL=

# URL del frontend autorizada por CORS (ej. http://localhost:5173)
FRONTEND_URL=

# Credenciales de Clerk (autenticación)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# String secreto de 32+ caracteres usado para cifrar credenciales SMTP por tenant (AES-256-GCM).
# Generar con: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=

# Configuración SMTP global de la aplicación (EP-17-b) — un único remitente para TODOS los tenants.
# Host del servidor SMTP (ej. smtp.sendgrid.net, smtp.gmail.com)
SMTP_HOST=
# Puerto SMTP (típicamente 465 o 587)
SMTP_PORT=
# true = TLS/SSL (puerto 465), false = STARTTLS (puerto 587)
SMTP_SECURE=
# Usuario/login SMTP de la cuenta de la aplicación
SMTP_USER=
# Contraseña SMTP de la cuenta de la aplicación (en texto plano en el .env, nunca versionado)
SMTP_PASSWORD=
# Email remitente de los recordatorios (el nombre visible sigue siendo el del tenant, ver mailService.ts)
SMTP_FROM_EMAIL=

# Claves VAPID para Web Push (UX-68). Generar una vez con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Email de contacto requerido por el protocolo VAPID (ej. mailto:contacto@tudominio.com)
VAPID_SUBJECT=
